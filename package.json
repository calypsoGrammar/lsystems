{
  "name": "lsystems",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=high",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "npm run typecheck && npm run audit:baseline:check && npm run build && npm test && npm run test:browser && npm run audit",
    "audit:baseline": "node scripts/baseline.mjs",
    "audit:baseline:check": "node scripts/baseline.mjs --check",
    "audit:browser": "node scripts/browser-baseline.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "modern-normalize": "^3.0.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  }
}
